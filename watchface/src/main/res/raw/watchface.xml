<?xml version="1.0"?>
<!--
  MU-TH-UR terminal watch face — WFF v4, 456×456 round (Pixel Watch 4 / Wear OS 6).
  Assets: boot.webp (interactive), boot_ambient.webp (ambient), from assets-src/webp/.
  TODO: bundle Share Tech Mono in res/font for exact CodePen typography.
-->
<WatchFace width="456" height="456" clipShape="CIRCLE">
    <Metadata key="CLOCK_TYPE" value="DIGITAL" />
    <Metadata key="PREVIEW_TIME" value="10:08:00" />

    <Scene backgroundColor="#ff000000">
        <!-- Interactive boot animation (WebP); replays when face becomes visible and each minute -->
        <PartAnimatedImage x="0" y="0" width="456" height="456" name="boot_interactive">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <AnimationController
                play="ON_VISIBLE ON_NEXT_MINUTE"
                repeat="FALSE"
                loopCount="1"
                afterPlaying="FIRST_FRAME" />
            <AnimatedImage resource="boot" format="WEBP" />
        </PartAnimatedImage>

        <!-- Ambient: shorter dim boot loop -->
        <PartAnimatedImage x="0" y="0" width="456" height="456" name="boot_ambient" alpha="0">
            <Variant mode="AMBIENT" target="alpha" value="255" />
            <AnimationController play="ON_VISIBLE" repeat="TRUE" />
            <AnimatedImage resource="boot_ambient" format="WEBP" />
        </PartAnimatedImage>

        <!-- Digital time (green terminal); thinner in ambient -->
        <DigitalClock x="0" y="0" width="456" height="456">
            <TimeText
                x="0"
                y="318"
                width="456"
                height="72"
                format="hh:mm"
                hourFormat="SYNC_TO_DEVICE"
                align="CENTER"
                alpha="255">
                <Variant mode="AMBIENT" target="alpha" value="0" />
                <Font
                    family="SYNC_TO_DEVICE"
                    size="64"
                    weight="NORMAL"
                    slant="NORMAL"
                    color="#ff7af042" />
            </TimeText>
            <TimeText
                x="0"
                y="318"
                width="456"
                height="72"
                format="hh:mm"
                hourFormat="SYNC_TO_DEVICE"
                align="CENTER"
                alpha="0">
                <Variant mode="AMBIENT" target="alpha" value="255" />
                <Font
                    family="SYNC_TO_DEVICE"
                    size="56"
                    weight="THIN"
                    slant="NORMAL"
                    color="#ff7af042" />
            </TimeText>
        </DigitalClock>

        <!-- Date complication (default system DATE provider) -->
        <ComplicationSlot
            x="56"
            y="400"
            width="160"
            height="40"
            slotId="0"
            name="date_slot"
            displayName="complication_date"
            supportedTypes="SHORT_TEXT">
            <DefaultProviderPolicy
                defaultSystemProvider="DATE"
                defaultSystemProviderType="SHORT_TEXT" />
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="0" width="160" height="40">
                    <Variant mode="AMBIENT" target="alpha" value="180" />
                    <Text align="START" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="18" color="#ff7af042">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!-- Battery complication (default WATCH_BATTERY provider) -->
        <ComplicationSlot
            x="240"
            y="400"
            width="160"
            height="40"
            slotId="1"
            name="battery_slot"
            displayName="complication_battery"
            supportedTypes="SHORT_TEXT RANGED_VALUE">
            <DefaultProviderPolicy
                defaultSystemProvider="WATCH_BATTERY"
                defaultSystemProviderType="SHORT_TEXT" />
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="0" width="160" height="40">
                    <Variant mode="AMBIENT" target="alpha" value="180" />
                    <Text align="END" ellipsis="TRUE">
                        <Font family="SYNC_TO_DEVICE" size="18" color="#ff7af042">
                            <Template><![CDATA[%s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>
    </Scene>
</WatchFace>

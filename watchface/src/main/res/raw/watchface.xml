<?xml version="1.0"?>
<!--
  MU-TH-UR terminal watch face — WFF v4, 456×456 round (Pixel Watch 4 / Wear OS 6).
  Layout: terminal box 274×220 @ (91,72); HUD footer DATE/BAT inside box;
  active time decode WebP @ y=296 then DigitalClock; ambient large centered time.
  Assets: assets-src/webp/ → drawable-nodpi/
-->
<WatchFace width="456" height="456" clipShape="CIRCLE">
    <Metadata key="CLOCK_TYPE" value="DIGITAL" />
    <Metadata key="PREVIEW_TIME" value="10:08:00" />

    <Scene backgroundColor="#ff000000">
        <!-- Terminal animations -->
        <PartAnimatedImage x="91" y="72" width="274" height="220" alpha="255" name="boot_active">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <AnimationController play="ON_VISIBLE" loopCount="1" beforePlaying="FIRST_FRAME" afterPlaying="FIRST_FRAME" />
            <AnimatedImage resource="boot" format="WEBP" />
        </PartAnimatedImage>

        <PartAnimatedImage x="91" y="72" width="274" height="220" alpha="255" name="computer_text_active">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <AnimationController play="ON_VISIBLE" loopCount="1" beforePlaying="FIRST_FRAME" afterPlaying="FIRST_FRAME" />
            <AnimatedImage resource="computer_text" format="WEBP" />
        </PartAnimatedImage>

        <PartAnimatedImage x="91" y="72" width="274" height="220" alpha="0" name="boot_ambient_loop">
            <Variant mode="AMBIENT" target="alpha" value="140" />
            <AnimationController play="ON_VISIBLE" repeat="TRUE" beforePlaying="FIRST_FRAME" afterPlaying="FIRST_FRAME" />
            <AnimatedImage resource="boot_ambient" format="WEBP" />
        </PartAnimatedImage>

        <!-- Active time decode overlay (plays once per visibility) -->
        <PartAnimatedImage x="0" y="192" width="456" height="72" alpha="255" name="time_decode_active">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <AnimationController play="ON_VISIBLE" loopCount="1" beforePlaying="FIRST_FRAME" afterPlaying="HIDE" />
            <AnimatedImage resource="time_decode" format="WEBP" />
        </PartAnimatedImage>

        <!-- Active time -->
        <DigitalClock x="0" y="192" width="456" height="72">
            <TimeText
                x="0"
                y="0"
                width="456"
                height="72"
                format="hh:mm"
                hourFormat="SYNC_TO_DEVICE"
                align="CENTER"
                alpha="255">
                <Variant mode="AMBIENT" target="alpha" value="0" />
                <Font
                    family="share_tech_mono"
                    size="88"
                    weight="NORMAL"
                    slant="NORMAL"
                    color="#ff7af042" />
            </TimeText>
        </DigitalClock>

        <!-- Ambient Option D: large centered time; terminal motion hidden/dimmed above -->
        <DigitalClock x="0" y="168" width="456" height="120">
            <TimeText
                x="0"
                y="0"
                width="456"
                height="120"
                format="hh:mm"
                hourFormat="SYNC_TO_DEVICE"
                align="CENTER"
                alpha="0">
                <Variant mode="AMBIENT" target="alpha" value="220" />
                <Font
                    family="share_tech_mono"
                    size="88"
                    weight="THIN"
                    slant="NORMAL"
                    color="#ff7af042" />
            </TimeText>
        </DigitalClock>

        <!-- HUD footer inside terminal: DATE (left) -->
        <ComplicationSlot
            x="101"
            y="264"
            width="130"
            height="28"
            slotId="0"
            name="date_footer"
            displayName="complication_date"
            supportedTypes="SHORT_TEXT">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <DefaultProviderPolicy
                defaultSystemProvider="DATE"
                defaultSystemProviderType="SHORT_TEXT" />
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="0" width="130" height="28">
                    <Text align="START" ellipsis="TRUE">
                        <Font family="share_tech_mono" size="16" color="#ff7af042">
                            <Template><![CDATA[DATE %s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>

        <!-- HUD footer inside terminal: BAT (right) -->
        <ComplicationSlot
            x="225"
            y="264"
            width="130"
            height="28"
            slotId="1"
            name="battery_footer"
            displayName="complication_battery"
            supportedTypes="SHORT_TEXT RANGED_VALUE">
            <Variant mode="AMBIENT" target="alpha" value="0" />
            <DefaultProviderPolicy
                defaultSystemProvider="WATCH_BATTERY"
                defaultSystemProviderType="SHORT_TEXT" />
            <Complication type="SHORT_TEXT">
                <PartText x="0" y="0" width="130" height="28">
                    <Text align="END" ellipsis="TRUE">
                        <Font family="share_tech_mono" size="16" color="#ff7af042">
                            <Template><![CDATA[BAT %s]]><Parameter expression="[COMPLICATION.TEXT]" /></Template>
                        </Font>
                    </Text>
                </PartText>
            </Complication>
        </ComplicationSlot>
    </Scene>
</WatchFace>

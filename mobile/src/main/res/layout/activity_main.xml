<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:padding="20dp">

    <!-- Header Terminal Banner -->
    <TextView
        android:id="@+id/tv_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="WEYLAND-YUTANI CORP // MU-TH-UR 6000"
        android:textColor="@color/terminal_green"
        android:textSize="16sp"
        android:textStyle="bold"
        android:typeface="monospace"
        android:gravity="center"
        android:padding="10dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <TextView
        android:id="@+id/tv_sub_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=" Weyland-Yutani Mainframe Core v9.6.1-A "
        android:textColor="@color/terminal_green"
        android:background="@color/terminal_green_dim"
        android:textSize="10sp"
        android:typeface="monospace"
        android:gravity="center"
        android:padding="4dp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/tv_header"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <!-- Terminal CRT Log Container (Border simulated via nested views) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/console_box"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="20dp"
        android:background="@color/dark_bg"
        android:padding="15dp"
        app:layout_constraintTop_toBottomOf="@id/tv_sub_header"
        app:layout_constraintBottom_toTopOf="@id/btn_diagnostic"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <!-- Glowing scanline background simulation (greenish grid hint) -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/terminal_green_dim"
            android:alpha="0.05" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <TextView
                android:id="@+id/tv_terminal_log"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/terminal_green"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.2"
                android:typeface="monospace"
                android:text="" />
        </ScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Terminal Interactive Button: Diagnostic -->
    <Button
        android:id="@+id/btn_diagnostic"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:text="RUN SYSTEM DIAGNOSTIC"
        android:textColor="@color/black"
        android:backgroundTint="@color/terminal_green"
        android:textStyle="bold"
        android:typeface="monospace"
        android:textSize="14sp"
        app:layout_constraintBottom_toTopOf="@id/btn_launch_watch"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <!-- Terminal Interactive Button: Wear OS Manager -->
    <Button
        android:id="@+id/btn_launch_watch"
        android:layout_width="0dp"
        android:layout_height="56dp"
        android:layout_marginBottom="10dp"
        android:text="LAUNCH SMARTWATCH MANAGER"
        android:textColor="@color/terminal_green"
        android:backgroundTint="@color/dark_bg"
        android:strokeColor="@color/terminal_green"
        android:strokeWidth="1dp"
        android:typeface="monospace"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
